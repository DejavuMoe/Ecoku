# 本文件不得包含密码、哈希或 key；实际秘密只从 ecoku.env 指定的环境变量读取。
# 容器固定以 UID/GID 10001 运行，绑定挂载时必须保证该用户拥有只读权限。
site:
  port: 12123
  log_path: "/data/ecoku.log"
  # 默认不信任 X-Forwarded-For。只有确认直接 socket 对端后才填写精确 IP/CIDR。
  trusted_proxies: []

rate_limit:
  window_seconds: 60
  comment_submit: 5
  comment_delete: 30
  admin_login: 5
  notification_test: 5

# 这里只提供空数据库首次初始化种子。初始化后，站点由管理端写入 SQLite 注册表；
# 修改本段不会覆盖数据库中的站点配置。
sites:
  - id: "example-site"
    site_url: "https://www.example.com"
    name: "示例站点"
    allowed_origins:
      - "https://www.example.com"
    management_key_env: "ECOKU_EXAMPLE_SITE_MANAGEMENT_KEY"
    comment:
      email_required: true
      website_required: false
      placeholder: "写下评论（仅支持纯文本）"
      default_sort: "newest"
      length_limit: 1000
      empty_message: |-
        还没有评论
        成为第一个留下评论的人。

notifications:
  # SMTP 密码与 Telegram Bot Token 使用此主密钥加密后保存到 SQLite。
  encryption_key_env: "ECOKU_NOTIFICATION_ENCRYPTION_KEY"
  # 通知中的原文链接只从站点 URL 与页面 key 拼接，不信任请求 Host。
  instance_public_url: "https://comments.example.com"

database:
  sqlite:
    path: "/data/ecoku.sqlite3"

admin:
  enabled: true
  static_dir: "/app/admin"
  username_env: "ECOKU_ADMIN_USERNAME"
  password_hash_env: "ECOKU_ADMIN_PASSWORD_HASH"
  token_key_env: "ECOKU_ADMIN_TOKEN_KEY"
  token_ttl_minutes: 480
  allowed_origins:
    - "https://comments.example.com"
