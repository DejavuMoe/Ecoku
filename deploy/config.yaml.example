# 本文件不得包含密码、哈希或 key；实际秘密只从 ecoku.env 指定的环境变量读取。
# 容器固定以 UID/GID 10001 运行，绑定挂载时必须保证该用户拥有只读权限。
site:
  port: 12123
  # 始终写入 stdout。普通文件路径会额外保留进程内轮转副本。
  log_path: "/var/log/ecoku/ecoku.log"
  # 空列表表示所有访客共用一个限流桶。生产若经本机 Caddy 反代到 127.0.0.1:12123
  # 且需要按真实访客限流，填 Docker 网关 /32。不要填 0.0.0.0/0 或 ::/0。
  trusted_proxies: []

# 镜像内置浏览器 SDK、加载器和可选评论区 CSS；不要把管理凭据放进这些静态资源。
client:
  static_dir: "/app/client"

rate_limit:
  window_seconds: 60
  comment_submit: 5
  comment_list: 60
  comment_delete: 30
  admin_login: 5
  notification_test: 5

notifications:
  # SMTP 密码与 Telegram Bot Token 使用此主密钥加密后保存到 SQLite。
  encryption_key_env: "ECOKU_NOTIFICATION_ENCRYPTION_KEY"
  # 启用通知时需填写实例地址；当前原文链接仍从站点 URL 与页面 key 拼接。
  instance_public_url: "https://ecoku.example.com"

database:
  sqlite:
    # 空库按顺序初始化到最新 schema；已有库只接受本版本迁移链上的顺序升级。
    path: "/data/ecoku.sqlite3"

admin:
  enabled: true
  static_dir: "/app/admin"
  username_env: "ECOKU_ADMIN_USERNAME"
  password_hash_env: "ECOKU_ADMIN_PASSWORD_HASH"
  token_key_env: "ECOKU_ADMIN_TOKEN_KEY"
  # 固定 8 小时；兼容键只允许 480，也可省略。
  token_ttl_minutes: 480
  allowed_origins:
    - "https://ecoku.example.com"
