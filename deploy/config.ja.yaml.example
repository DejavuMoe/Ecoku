# Ecoku の全設定例。app/config.yaml に保存し、変更後はコンテナを再作成します。
# 有効な値は既定値です。ただし instance_public_url の例は自分の URL に変更してください。
# トップレベルの各節は一度だけ記述します。${ENV} 環境変数はここでは展開されません。
# SMTP、Telegram、CAPTCHA、Smoji は管理画面で設定します。sites は初期サイトと管理認証情報の対応付けに使います。
# インスタンス設定の省略時は既定値を使います。管理オリジンは instance_public_url または admin.allowed_origins で指定してください。
# コメント内の代入も有効な設定です。既定の動作を変えるときだけコメントを外してください。

notifications:
  # Ecoku 自体の公開 URL。管理画面のオリジン検証と通知の有効化時に使います。
  # 既定値は空文字列。新規デプロイではブログではなく Ecoku の HTTPS URL を設定します。
  # 値：完全な http:// または https:// URL。認証情報、クエリー、フラグメントは含めません。
  # ローカル開発の例：http://127.0.0.1:12123。公開 URL の例は次の行です。
  # パスも指定できますが、この項目はリバースプロキシやアプリのルートを設定しません。
  instance_public_url: "https://ecoku.example.com"

  # 任意：暗号化キーを格納する環境変数名です。キー自体ではありません。
  # 既定：ECOKU_NOTIFICATION_ENCRYPTION_KEY。変更例：MY_ECOKU_KEY。
  # 変数の値は 32 バイトのキーを標準 Base64 で表したものです。パディングは任意です。
  # 新規インスタンスはキーを自動生成し、DB と同じ場所の ecoku-secrets.json に保存します。
  # 環境変数を渡す場合は永続ファイルの通知キーと一致させてください。不一致なら起動を拒否します。
  # encryption_key_env: "ECOKU_NOTIFICATION_ENCRYPTION_KEY"

site:
  # 信頼する直接接続元プロキシ。既定：[]。IPv4、IPv6、CIDR を指定できます。
  # 例：["172.18.0.1/32"]。1 行に 1 アドレスの YAML リストも使えます。
  # ホストのリバースプロキシから Docker 経由で接続する場合、通常は Docker ゲートウェイを指定します。
  # 確認：sudo docker inspect ecoku --format '{{range .NetworkSettings.Networks}}{{.Gateway}}{{"\n"}}{{end}}'
  # 管理下のプロキシだけを信頼し、クライアントの X-Forwarded-For を上書きしてください。
  # 空なら転送ヘッダーを無視します。プロキシ配下の訪問者は同じ制限枠を共有する場合があります。
  # 0.0.0.0/0 と ::/0 は禁止です。例のゲートウェイをそのまま使わず実際の値を確認してください。
  trusted_proxies: []

  # 任意：待受ポート。既定 12123。1～65535 の整数、0 は既定値を使います。
  # Docker では Compose のホスト側ポートを変更すればよく、コンテナ側は変更不要です。
  # コンテナの待受ポートを変える場合、Compose のポート対応とヘルスチェックも合わせてください。
  # port: 12123
  # 任意：ログファイルのパス。既定 "" は標準出力。docker compose logs で確認します。
  # 例：/var/log/ecoku/ecoku.log。ファイル出力には書き込み可能なディレクトリのマウントが必要です。
  # "-"、"stdout"、"/dev/stdout" も標準出力のみ。他のパスは標準出力とファイルの両方に記録します。
  # log_path: ""

rate_limit:
  # 以下はすべて整数です。省略または 0 は既定値を使い、負数は起動時に拒否されます。
  # 有効値は正の整数です。無効化を表す値はありません。妥当な小さい値を使ってください。
  # 直接接続元または信頼する代理が転送した訪問者 IP ごとに、API の種類別に計数します。
  # 超過時は HTTP 429 と Retry-After を返します。メモリ内のカウンターは再起動でリセットされます。

  # 計数期間（秒）。既定 60。例：120 は 2 分間です。
  window_seconds: 60
  # 期間内のコメント投稿回数（返信を含む）。既定 5、例 10。
  comment_submit: 5
  # 期間内の公開コメント一覧の取得回数。既定 60、例 120。
  comment_list: 60
  # 期間内のコメント削除回数。既定 30、例 60。
  comment_delete: 30
  # 期間内の管理者ログイン試行回数。既定 5、例 10。
  admin_login: 5
  # 期間内のテスト通知回数。既定 5、例 10。
  notification_test: 5

admin:
  # 管理 API を利用できるブラウザのオリジン。既定 [] は instance_public_url から取得します。
  # 値：重複しない http(s)://ホスト[:ポート]。パス、クエリー、フラグメントは不可です。
  # 例：["https://ecoku.example.com", "https://admin.example.com"]。
  # 管理画面を複数 URL で利用する場合やフロントエンド分離開発時だけ明示します。
  # ブログのコメント用オリジンと分けてください。公開の管理オリジンは HTTPS が必要です。
  # このリストと instance_public_url が両方空だと、管理オリジンがないため起動に失敗します。
  allowed_origins: []

  # 任意：セッションは 480 分（8 時間）固定で、調整可能なタイムアウトではありません。
  # 省略、0、480 のみ有効です。他の整数は起動時に拒否され、操作しても期限は延びません。
  # token_ttl_minutes: 480
  # 任意：管理画面の静的ディレクトリ。Docker の既定 /app/admin、ソース実行は空です。
  # ソース実行で空の場合、管理画面の静的配信は行いませんが管理 API は有効です。
  # 例：../packages/admin/dist。Docker では空でも /app/admin を使います。
  # static_dir: "/app/admin"

  # 管理者の初期認証情報を環境変数で渡す場合の設定です。値がなければ永続アカウントを利用または作成します。
  # 3 項目は変数名で、認証情報自体ではありません。YAML だけでは環境変数を注入しません。
  # 既定値は各行を参照。変更例：MY_ADMIN_USER、MY_ADMIN_HASH、MY_ADMIN_KEY。
  # 名前は英字または _ で始め、英数字と _ のみを推奨します。3 つの名前は別々にしてください。
  # 管理者認証情報を一つでも設定した場合、3 つすべてを設定する必要があります。
  # ユーザー名 1～80 文字、パスワードは cost >= 10 の bcrypt ハッシュ、署名キーは 32 バイト以上。
  # 認証情報を渡さない場合、アカウントの初回作成時に admin の仮パスワードを出力し、初回ログインで変更します。
  # username_env: "ECOKU_ADMIN_USERNAME"
  # password_hash_env: "ECOKU_ADMIN_PASSWORD_HASH"
  # token_key_env: "ECOKU_ADMIN_TOKEN_KEY"

# 任意：コメントクライアントの静的ディレクトリ。Docker の既定 /app/client。
# ソース実行の既定は空で静的スクリプトを配信しません。例：../packages/client/dist。
# client:
#   static_dir: "/app/client"

# 任意：SQLite のみ。ディレクトリではなく DB ファイルのパスを指定します。
# Docker の既定：/data/ecoku.sqlite3。ソース実行の既定：./data/ecoku.bin。
# 例：/data/comments.sqlite3。書き込み可能でコンテナ外に永続化するディレクトリを使ってください。
# ecoku-secrets.json は DB と同じ場所にあります。必ず一緒にバックアップ、移動してください。
# DB パスを変えてもデータは移動しません。指定先がなければ新しい DB を作成します。
# database:
#   sqlite:
#     path: "/data/ecoku.sqlite3"

# 任意：YAML のサイト初期データ。既定 []。新規サイトは管理画面で作成します。
# 新規 DB 作成時だけ取り込みます。ここを編集しても既存 DB のサイトは更新されません。
# 初期サイトを設定する場合、以下の sites 節全体のコメントを外してください。
# sites:
#   # 必須 ID：英数字で開始し、英数字、.、_、- のみ。最大 100 文字。
#   - id: "blog"
#     # サイト URL に固定の既定値はありません。空なら allowed_origins の最初の値を使います。
#     # 認証情報、クエリー、フラグメントのない http(s) URL。例はブログのルート URL です。
#     site_url: "https://blog.example.com"
#     # 表示名。既定は空でドメインを表示します。最大 120 文字。
#     name: "我的博客"
#     # 重複しないオリジンが 1 つ以上必須。パス等を含めず、管理オリジンと分けてください。
#     allowed_origins: ["https://blog.example.com"]
#     # サイト管理認証情報の環境変数名（任意）。既定の空文字列では使用しません。
#     # EcokuSite 認証情報は自サイトのコメントを墓標化するためだけに使い、管理データは読み取れません。
#     # 例：BLOG_MANAGEMENT_KEY、値は 32 バイト以上。サイトごとに変数名と値を分けてください。
#     # ブラウザや公開の埋め込みコードに含めないでください。
#     # この認証情報の対応付けは初回のサイト取り込み時だけでなく、起動ごとに適用します。
#     management_key_env: ""
#     comment:
#       # メール必須。既定 true、選択肢 true / false。
#       email_required: true
#       # ウェブサイト必須。既定 false、選択肢 true / false。
#       website_required: false
#       # 入力欄の文言。既定値は次の行。最大 80 文字、改行不可、空なら既定文言を使います。
#       placeholder: "写下评论（仅支持纯文本）"
#       # 並び順：newest（新しい順、既定）または oldest（古い順）。
#       default_sort: "newest"
#       # コメント文字数上限。既定 1000、範囲 1～10000。0 は既定値。
#       length_limit: 1000
#       # コメントなしの文言。既定値は次の行。最大 240 文字、\n で改行、空なら既定値。
#       empty_message: "还没有评论\n成为第一个留下评论的人。"
