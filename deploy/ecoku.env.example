# 复制为 ecoku.env 后填写。管理员用户名、密码哈希或签名密钥为空时，Ecoku 拒绝启动。
# 每个值使用单引号，避免 Compose 插值 bcrypt 哈希中的 $ 字符。
# 每个 key 必须独立生成，至少 32 个随机字符；不得复用。
GIN_MODE='release'
TZ='Asia/Shanghai'
ECOKU_ADMIN_USERNAME=''
# 这里只放 bcrypt 哈希，不放明文密码。
ECOKU_ADMIN_PASSWORD_HASH=''
ECOKU_ADMIN_TOKEN_KEY=''
# Base64 编码的独立 32 字节密钥（带填充或无填充均可）；用于加密通知凭据。
ECOKU_NOTIFICATION_ENCRYPTION_KEY=''
