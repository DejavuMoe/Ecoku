# 复制为 ecoku.env，chmod 600。每个值用单引号包住，避免 bcrypt 哈希中的 $ 被 Compose 展开。

# 评论与通知的显示时区（IANA 名称）
TZ='Asia/Shanghai'

# 管理后台用户名，1～80 个字符
ECOKU_ADMIN_USERNAME='admin'

# 管理员密码的 bcrypt 哈希，不放明文密码。生成：
#   read -rsp '管理员密码: ' P; echo
#   printf '%s\n' "$P" | sudo docker run --rm -i git.via.moe/dejavu/ecoku:v0.2.8 hash-password; unset P
ECOKU_ADMIN_PASSWORD_HASH=''

# 管理员会话签名密钥，至少 32 个字符。生成：openssl rand -hex 32
ECOKU_ADMIN_TOKEN_KEY=''

# 加密数据库中 SMTP 密码、Bot Token 与人机验证密钥的主密钥（Base64 编码的 32 字节）。
# 生成：openssl rand -base64 32。丢失后已保存的凭据无法解密，请与数据库一起备份。
ECOKU_NOTIFICATION_ENCRYPTION_KEY=''
