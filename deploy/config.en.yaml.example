# Complete Ecoku configuration. Save as app/config.yaml; recreate the container after changes.
# Active values are defaults, except the example instance_public_url that you must replace.
# Write each top-level section once. YAML does not expand ${ENV} variables here.
# Configure SMTP, Telegram, CAPTCHA and Smoji in the console; sites supplies initial sites and credential bindings.
# Omitted instance options use defaults; supply an admin origin via instance_public_url or admin.allowed_origins.
# Commented assignments are supported options. Uncomment only to override default behavior.

notifications:
  # Public URL of Ecoku itself, used for admin-origin checks and when enabling notifications.
  # Default: empty string. For a new deployment, set your actual HTTPS URL, not the blog URL.
  # Values: full http:// or https:// URL, without credentials, query parameters or fragment.
  # Local development example: http://127.0.0.1:12123. Public example below.
  # A path is accepted, but this field does not configure your reverse proxy or change application routes.
  instance_public_url: "https://ecoku.example.com"

  # Optional: environment variable NAME holding the encryption key, not the key itself.
  # Default: ECOKU_NOTIFICATION_ENCRYPTION_KEY. Custom example: MY_ECOKU_KEY.
  # The variable value must be a 32-byte key in standard Base64, with or without padding.
  # New instances generate keys and save them in ecoku-secrets.json beside the database.
  # If injected, the value must match the notification key in the persistent file; mismatch prevents startup.
  # encryption_key_env: "ECOKU_NOTIFICATION_ENCRYPTION_KEY"

site:
  # Trusted direct proxies. Default: []. Accepts IPv4, IPv6 addresses or CIDR networks.
  # Example: ["172.18.0.1/32"]. A YAML list with one address per line also works.
  # For a host reverse proxy forwarding through Docker, normally use the actual Docker gateway.
  # Query: sudo docker inspect ecoku --format '{{range .NetworkSettings.Networks}}{{.Gateway}}{{"\n"}}{{end}}'
  # Trust only proxies you control; the proxy must overwrite client-supplied X-Forwarded-For.
  # Empty ignores forwarding headers; visitors behind a proxy may share one rate-limit allowance.
  # 0.0.0.0/0 and ::/0 are forbidden. Do not assume the example gateway is your gateway.
  trusted_proxies: []

  # Optional: listen port. Default 12123; integer 1–65535; 0 selects the default.
  # Docker users can change the host-side Compose port mapping without changing the container port.
  # Changing the container listen port also requires updating its Compose mapping and health check.
  # port: 12123
  # Optional: log file path. Default "" writes to stdout; view with docker compose logs.
  # Example: /var/log/ecoku/ecoku.log. File logging needs a writable directory mount.
  # "-", "stdout" and "/dev/stdout" also select stdout only; other paths keep both stdout and file logs.
  # log_path: ""

rate_limit:
  # All fields below are integers. Omitted or 0 selects the default; negatives prevent startup.
  # Effective values must be positive. There is no disable value; use reasonable small integers.
  # Count separately per peer IP or trusted forwarded visitor IP, with separate endpoint categories.
  # Excess requests return HTTP 429 and Retry-After. In-memory counters reset on restart.

  # Window duration in seconds. Default 60; example 120 means a two-minute window.
  window_seconds: 60
  # Comment submissions including replies per window. Default 5; example 10.
  comment_submit: 5
  # Public comment-list requests per window. Default 60; example 120.
  comment_list: 60
  # Comment deletions per window. Default 30; example 60.
  comment_delete: 30
  # Administrator login attempts per window. Default 5; example 10.
  admin_login: 5
  # Test notification requests per window. Default 5; example 10.
  notification_test: 5

admin:
  # Browser origins allowed for the admin API. Default [] derives the origin from instance_public_url.
  # Values: unique http(s)://host[:port] entries, without a path, query or fragment.
  # Example: ["https://ecoku.example.com", "https://admin.example.com"].
  # Set explicitly only for multiple admin URLs or separate frontend/backend development.
  # Keep separate from blog comment origins. Public admin origins must use HTTPS.
  # If both this list and instance_public_url are empty, startup fails for lack of an admin origin.
  allowed_origins: []

  # Optional: sessions are fixed at 480 minutes (8 hours), not a tunable timeout.
  # Omit it, set 0 or 480. Other integers prevent startup. Activity does not extend the session.
  # token_ttl_minutes: 480
  # Optional: admin static directory. Docker default /app/admin; source-run default empty.
  # Empty in source runs disables static admin pages, but leaves the admin API enabled.
  # Example: ../packages/admin/dist. Empty in Docker still uses /app/admin.
  # static_dir: "/app/admin"

  # Optional administrator bootstrap credential sources; absent values use or create a persistent account.
  # These are variable names, not credential values. YAML alone does not inject environment variables.
  # Defaults below. Custom examples: MY_ADMIN_USER, MY_ADMIN_HASH, MY_ADMIN_KEY.
  # Prefer letters/digits/underscores with a letter or underscore first; the three names must differ.
  # Supplying any administrator credential variable requires supplying all three.
  # Username: 1–80 characters; password: bcrypt hash with cost >= 10; signing key: at least 32 bytes.
  # Without these credential values, initial account creation prints an admin temporary password to change on first login.
  # username_env: "ECOKU_ADMIN_USERNAME"
  # password_hash_env: "ECOKU_ADMIN_PASSWORD_HASH"
  # token_key_env: "ECOKU_ADMIN_TOKEN_KEY"

# Optional: static comment-client directory. Docker default /app/client.
# Source-run default: empty, serving no static scripts. Example: ../packages/client/dist.
# client:
#   static_dir: "/app/client"

# Optional: SQLite only. Specify a database FILE path, not a directory.
# Docker default: /data/ecoku.sqlite3. Source-run default: ./data/ecoku.bin.
# Example: /data/comments.sqlite3. The directory must be writable and persist outside the container.
# ecoku-secrets.json lives beside the database. Back up and move them together.
# Changing the database path does not move data; a missing target creates a new database.
# database:
#   sqlite:
#     path: "/data/ecoku.sqlite3"

# Optional: YAML site seeds. Default []. Create new sites in the admin console.
# Imported only when creating a brand-new database. Editing this does not update existing database sites.
# To seed initial sites, uncomment the entire sites section below.
# sites:
#   # Required ID: letter/digit first; letters, digits, dots, underscores, hyphens; at most 100 characters.
#   - id: "blog"
#     # Site URL has no fixed default. Empty falls back to the first allowed_origins entry.
#     # Full http(s) URL without credentials, query or fragment. The example is the blog root URL.
#     site_url: "https://blog.example.com"
#     # Display name. Default empty falls back to the domain. At most 120 characters.
#     name: "我的博客"
#     # At least one unique origin is required, without path/query/fragment and distinct from admin origins.
#     allowed_origins: ["https://blog.example.com"]
#     # Comment language. Default zh-CN; values zh-CN, zh-Hant, en. The loader's data-i18n attribute or the SDK i18n option overrides it.
#     i18n: "zh-CN"
#     # Optional variable name for a site management credential. Default empty disables this credential.
#     # EcokuSite credentials can only tombstone comments on this site, not read admin data.
#     # Example: BLOG_MANAGEMENT_KEY, at least 32 bytes; each site needs a different variable and key.
#     # Never expose it in a browser or public integration code.
#     # This credential binding applies on every startup, not only during the first site seed import.
#     management_key_env: ""
#     comment:
#       # Require email. Default true; values true / false.
#       email_required: true
#       # Require website. Default false; values true / false.
#       website_required: false
#       # Input placeholder, default below. At most 80 characters, no newline; empty uses the default.
#       placeholder: "写下评论（仅支持纯文本）"
#       # Default order: newest (default) or oldest.
#       default_sort: "newest"
#       # Comment character limit. Default 1000; values 1–10000; 0 selects the default.
#       length_limit: 1000
#       # Empty-state text, default below. At most 240 characters; \n for line breaks; empty uses the default.
#       empty_message: "还没有评论\n成为第一个留下评论的人。"
